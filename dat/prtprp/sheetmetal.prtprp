<?xml version="1.0" encoding="UTF-8"?>
<CPTemplate>
  <AppVersion>33</AppVersion>
  <CPSheet>
    <GroupBox Label="Part" PropName="Groupbox1" DefaultState="Expanded">
      <Control Label="Component type" PropName="SWOOD_TYPE" ApplyTo="Global" Type="TextBox" ReadOnly="False" DefaultValue="Sheet Metal" Mode="Text" />
      <Control Label="Description" PropName="Description" ApplyTo="Global" Type="TextBox" ReadOnly="False" DefaultValue="" Mode="Text" />
    </GroupBox>
    <GroupBox Label="Material and finish" PropName="Groupbox2" DefaultState="Expanded">
      <Control Label="Material" PropName="SM Material" ApplyTo="Global" Type="ComboBox" ReadOnly="False" UserDefineable="True">
        <Data Path="" SourceType="List">
          <Item></Item>
          <Item>AISI 304</Item>
          <Item>AISI 316</Item>
          <Item>AISI 202</Item>
          <Item>AISI 430</Item>
          <Item>Plain Carbon Steel</Item>
          <Item>Galvanised Steel</Item>
          <Item>Aluminium 5052</Item>
        </Data>
      </Control>
      <Control Label="Surface Finish" PropName="Surface Finish" ApplyTo="Global" Type="ComboBox" ReadOnly="False" UserDefineable="False">
        <Data Path="" SourceType="List">
          <Item></Item>
          <Item>RED OXIDE</Item>
          <Item>RED OXIDE + POWDERCOAT</Item>
          <Item>RED OXIDE + PAINT</Item>
          <Item>POWDERCOAT</Item>
          <Item>PAINT</Item>
          <Item>GALVANISED</Item>
          <Item>BUFFING</Item>
          <Item>PVD</Item>
          <Item>Clear Lacquared</Item>
          <Item>PU Matt Clear Lacquer</Item>
          <Item>PU High Gloss Clear Lacquer</Item>
          <Item>Hand Miror Polishing</Item>
        </Data>
      </Control>
      <Control Label="RAL Colour" PropName="RAL Colour" ApplyTo="Global" Type="ComboBox" ReadOnly="False" UserDefineable="True">
        <Data Path="" SourceType="List">
          <Item></Item>
          <Item>RAL 1013</Item>
          <Item>RAL 1015</Item>
          <Item>RAL 3000</Item>
          <Item>RAL 3004</Item>
          <Item>RAL 5010</Item>
          <Item>RAL 5013</Item>
          <Item>RAL 6000</Item>
          <Item>RAL 6001</Item>
          <Item>RAL 6020</Item>
          <Item>RAL 7016</Item>
          <Item>RAL 7035</Item>
          <Item>RAL 8017</Item>
          <Item>RAL 9005</Item>
          <Item>RAL 9010</Item>
          <Item>RAL 9016</Item>
        </Data>
      </Control>
      <Control Label="Coated Sides" PropName="Coat Sides" ApplyTo="Global" Type="ComboBox" ReadOnly="False" UserDefineable="False">
        <Data Path="" SourceType="List">
          <Item></Item>
          <Item>1</Item>
          <Item>2</Item>
        </Data>
      </Control>
    </GroupBox>
    <GroupBox Label="Nesting" PropName="Groupbox3" DefaultState="Expanded">
      <Control Label="Grain Direction" PropName="Grain Direction" ApplyTo="Global" Type="ComboBox" ReadOnly="False" UserDefineable="False">
        <Data Path="" SourceType="List">
          <Item>Any</Item>
          <Item>Length</Item>
          <Item>Width</Item>
        </Data>
      </Control>
    </GroupBox>
    <GroupBox Label="Report" PropName="Groupbox4" DefaultState="Expanded">
      <Control Label="Exclude from report" PropName="Exclude" ApplyTo="Global" Type="CheckBox" ReadOnly="False" DefaultValue="0" PropValueChecked="Yes" PropValueUnchecked="No" />
    </GroupBox>
    <GroupBox Label="Written by CopySheetMetalProps - do not type" PropName="Groupbox5" DefaultState="Collapsed">
      <Control Label="Sheet Metal Thickness" PropName="Sheet Metal Thickness" ApplyTo="Global" Type="TextBox" ReadOnly="True" DefaultValue="" Mode="Text" />
      <Control Label="Sheet Metal Gauge" PropName="Sheet Metal Gauge" ApplyTo="Global" Type="TextBox" ReadOnly="True" DefaultValue="" Mode="Text" />
      <Control Label="Bounding Box Length" PropName="Bounding Box Length" ApplyTo="Global" Type="TextBox" ReadOnly="True" DefaultValue="" Mode="Text" />
      <Control Label="Bounding Box Width" PropName="Bounding Box Width" ApplyTo="Global" Type="TextBox" ReadOnly="True" DefaultValue="" Mode="Text" />
      <Control Label="Bounding Box Area-Blank" PropName="Bounding Box Area-Blank" ApplyTo="Global" Type="TextBox" ReadOnly="True" DefaultValue="" Mode="Text" />
      <Control Label="Bends" PropName="Bends" ApplyTo="Global" Type="TextBox" ReadOnly="True" DefaultValue="" Mode="Text" />
      <Control Label="Bend Radius" PropName="Bend Radius" ApplyTo="Global" Type="TextBox" ReadOnly="True" DefaultValue="" Mode="Text" />
      <Control Label="Cut Outs" PropName="Cut Outs" ApplyTo="Global" Type="TextBox" ReadOnly="True" DefaultValue="" Mode="Text" />
      <Control Label="Cutting Length-Outer" PropName="Cutting Length-Outer" ApplyTo="Global" Type="TextBox" ReadOnly="True" DefaultValue="" Mode="Text" />
      <Control Label="Cutting Length-Inner" PropName="Cutting Length-Inner" ApplyTo="Global" Type="TextBox" ReadOnly="True" DefaultValue="" Mode="Text" />
      <Control Label="Mass" PropName="Mass" ApplyTo="Global" Type="TextBox" ReadOnly="True" DefaultValue="" Mode="Text" />
    </GroupBox>
  </CPSheet>
</CPTemplate>
